[Unit]
Description=Omochi public iroh relay
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
DynamicUser=true
StateDirectory=omochi-relay
StateDirectoryMode=0700
WorkingDirectory=/var/lib/omochi-relay
ExecStartPre=/usr/bin/test -s /etc/omochi-relay/relay.toml
ExecStart=/usr/local/bin/iroh-relay --config-path /etc/omochi-relay/relay.toml
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
UMask=0077
LimitNOFILE=8192
MemoryMax=1G
TasksMax=256
IPAccounting=true

[Install]
WantedBy=multi-user.target
