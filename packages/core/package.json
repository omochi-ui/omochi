{
  "name": "@omochi-ui/core",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "version": "0.2.1",
  "description": "Transport primitives shared by the omochi-ui hub, gateway, and stdio bridge",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun check -p tsconfig.test.json && bun test ./test",
    "typecheck": "bun check -p tsconfig.json"
  },
  "dependencies": {
    "@a2ui/web_core": "0.15.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~6.0.3",
    "@types/bun": "^1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omochi-ui/omochi.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/omochi-ui/omochi#readme",
  "bugs": {
    "url": "https://github.com/omochi-ui/omochi/issues"
  }
}
