{
  "name": "@omochi-ui/hub-ui",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./contracts": {
      "types": "./dist/contracts/contracts.d.ts",
      "default": "./dist/contracts/contracts.js"
    },
    "./assets": "./dist/index.html"
  },
  "scripts": {
    "build": "bun check -p tsconfig.app.json && vite build && tsc -p tsconfig.contracts.json",
    "typecheck": "bun check -p tsconfig.app.json",
    "dev": "vite",
    "lint": "oxlint",
    "test": "bun check -p tsconfig.test.json && bun test ./test",
    "build:hosted": "bun check -p tsconfig.hosted.json && vite build --config vite.hosted.config.ts"
  },
  "dependencies": {
    "@omochi-ui/renderer": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@omochi-ui/core": "workspace:*",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "ajv": "8.20.0",
    "oxlint": "^1.90.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.0",
    "@omochi-ui/hub-transport": "workspace:*",
    "fake-indexeddb": "6.2.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omochi-ui/omochi.git",
    "directory": "packages/hub-ui"
  },
  "homepage": "https://github.com/omochi-ui/omochi#readme",
  "bugs": {
    "url": "https://github.com/omochi-ui/omochi/issues"
  }
}
