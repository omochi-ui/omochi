{
  "name": "@omochi-ui/hub-ui",
  "version": "0.1.1",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "files": ["dist"],
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./contracts": {
      "types": "./dist/contracts/contracts.d.ts",
      "default": "./dist/contracts/contracts.js"
    },
    "./assets": "./dist/index.html"
  },
  "scripts": {
    "build": "tsc -p tsconfig.app.json && vite build && tsc -p tsconfig.contracts.json",
    "typecheck": "tsc -p tsconfig.app.json",
    "dev": "vite",
    "lint": "oxlint",
    "test": "tsc -p tsconfig.test.json && bun test ./test"
  },
  "dependencies": {
    "@omochi-ui/renderer": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "@omochi-ui/core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omochi-ui/omochi.git",
    "directory": "packages/hub-ui"
  },
  "homepage": "https://github.com/omochi-ui/omochi#readme",
  "bugs": {
    "url": "https://github.com/omochi-ui/omochi/issues"
  }
}
