{
  "name": "@omochi-ui/sdk",
  "version": "0.2.2",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Declarative, transport-independent application runtime for A2UI",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@a2ui/web_core": "0.15.0",
    "@omochi-ui/core": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "@types/node": "^24.13.3",
    "@types/bun": "^1.3.0",
    "@types/ws": "^8.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "bun check -p tsconfig.test.json",
    "lint": "oxlint",
    "test": "bun check -p tsconfig.test.json && bun test ./test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omochi-ui/omochi.git",
    "directory": "packages/sdk/typescript"
  },
  "homepage": "https://github.com/omochi-ui/omochi#readme",
  "bugs": {
    "url": "https://github.com/omochi-ui/omochi/issues"
  },
  "optionalDependencies": {
    "@omochi-ui/local-linux-x64-gnu": "0.2.2",
    "@omochi-ui/local-linux-x64-musl": "0.2.2",
    "@omochi-ui/local-linux-arm64-gnu": "0.2.2",
    "@omochi-ui/local-linux-arm64-musl": "0.2.2",
    "@omochi-ui/local-darwin-x64": "0.2.2",
    "@omochi-ui/local-darwin-arm64": "0.2.2",
    "@omochi-ui/local-win32-x64": "0.2.2",
    "@omochi-ui/local-win32-arm64": "0.2.2"
  }
}
