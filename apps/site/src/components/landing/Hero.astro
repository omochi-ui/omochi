---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../../i18n';
import type { Messages } from '../../i18n/ja';

interface Props {
  copy: Messages['landing']['hero'];
  locale: Locale;
}
const { copy, locale } = Astro.props;
---
<section class="hero wrap">
  <h1>{copy.title}<br /><em>{copy.emphasis}</em></h1>
  <p class="intro">{copy.description}</p>
  <div class="actions">
    <a class="button" href={getRelativeLocaleUrl(locale, 'docs/start/first-ui')}>
      {copy.cta} <span>↗</span>
    </a>
    <a class="text-link" href="#how">{copy.more} ↓</a>
  </div>
  <div class="hero-note">{copy.note}</div>
</section>
