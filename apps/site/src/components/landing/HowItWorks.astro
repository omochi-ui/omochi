---
import type { Messages } from '../../i18n/ja';

interface Props {
  copy: Messages['landing']['how'];
}
const { copy } = Astro.props;
---
<section class="section wrap" id="how">
  <div class="section-heading">
    <div>
      <span class="eyebrow">{copy.eyebrow}</span>
      <h2>{copy.title}</h2>
    </div>
    <p>{copy.description}</p>
  </div>
  <div class="steps">
    <article>
      <span>01</span>
      <h3>{copy.declareTitle}</h3>
      <p>{copy.declareDescription}</p>
    </article>
    <article>
      <span>02</span>
      <h3>{copy.actionTitle}</h3>
      <p>{copy.actionDescription}</p>
    </article>
    <article>
      <span>03</span>
      <h3>{copy.renderTitle}</h3>
      <p>{copy.renderDescription}</p>
    </article>
  </div>
</section>
