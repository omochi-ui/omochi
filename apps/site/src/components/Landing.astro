---
import Site from '../layouts/Site.astro';
import { getLocale, getMessages } from '../i18n';
import Hero from './landing/Hero.astro';
import Workbench from './landing/Workbench.astro';
import HowItWorks from './landing/HowItWorks.astro';
import Dashboard from './landing/Dashboard.astro';
import Paths from './landing/Paths.astro';
import Closing from './landing/Closing.astro';

const locale = getLocale(Astro.currentLocale);
const copy = getMessages(locale);
---

<Site locale={locale} copy={copy}>
  <Hero copy={copy.landing.hero} locale={locale} />
  <Workbench copy={copy.landing.workbench} />
  <HowItWorks copy={copy.landing.how} />
  <Dashboard copy={copy.landing.dashboard} />
  <Paths copy={copy.landing.paths} locale={locale} />
  <Closing copy={copy.landing.closing} locale={locale} />
</Site>
