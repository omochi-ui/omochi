{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omochi-dashboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "app.omochi.fyi", "custom_domain": true }],
  "assets": {
    "directory": "../../packages/hub-ui/dist-hosted",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
