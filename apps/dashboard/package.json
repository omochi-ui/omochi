{
  "name": "@omochi-ui/dashboard-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run --cwd ../.. build:hosted",
    "dev": "wrangler dev --ip 127.0.0.1",
    "deploy": "wrangler deploy",
    "check": "bun check -p tsconfig.json && bun test ./test",
    "test:preview": "bun run build && node test/preview.mjs",
    "dry-run": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "wrangler": "4.156.2",
    "@types/bun": "^1.3.0"
  }
}
